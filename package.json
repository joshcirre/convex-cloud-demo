{
  "name": "convex-cloud-demo",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "NITRO_HOST=:: node .output/server/index.mjs",
    "format": "prettier --write .",
    "lint": "npm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "convex:dev": "convex dev --env-file .env.self-hosted",
    "convex:deploy": "convex deploy --env-file .env.self-hosted"
  },
  "dependencies": {
    "@convex-dev/react-query": "^0.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-with-query": "^1.130.17",
    "@tanstack/react-start": "^1.168.36",
    "convex": "1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "nitro": "3.0.260903-beta",
    "eslint": "^10.0.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "convex": {
      "ws": "^8.21.0"
    }
  }
}
